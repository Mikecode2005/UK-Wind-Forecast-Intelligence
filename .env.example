# Elexon BMRS API
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1/datasets
ELEXON_ENABLE_CACHE=1
ELEXON_REQUEST_TIMEOUT=40
ELEXON_HTTP_VERIFY=false

# Backend
BACKEND_PORT=8000

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000

# Analysis defaults
ANALYSIS_FROM=2026-01-01
ANALYSIS_TO=2026-01-31
FORECAST_CUTOFF_HOUR=11
FORECAST_CUTOFF_MINUTE=0

# AI insights — NVIDIA Integrate (OpenAI-compatible)
# Paste your key here (backend only; never commit the real key)
NVIDIA_API_KEY=
# AI_API_KEY=          # alternative name also accepted
# OPENAI_API_KEY=      # also accepted

AI_API_BASE=https://integrate.api.nvidia.com/v1
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
