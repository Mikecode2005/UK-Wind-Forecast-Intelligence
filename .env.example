# Elexon BMRS API
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1/datasets
ELEXON_ENABLE_CACHE=1
ELEXON_REQUEST_TIMEOUT=40
# NOTE: Python's SSL store cannot verify the Elexon certificate in some
# sandboxed environments. If fetch_dataset fails with a certificate error,
# set ELEXON_HTTP_VERIFY=false to disable server certificate verification
# (only appropriate for isolated/local development).
ELEXON_HTTP_VERIFY=false

# Backend
BACKEND_PORT=8000

# Frontend (Vite)
VITE_API_BASE=http://localhost:8000

# Analysis defaults
ANALYSIS_FROM=2026-01-01
ANALYSIS_TO=2026-01-31
FORECAST_CUTOFF_HOUR=11
FORECAST_CUTOFF_MINUTE=0
