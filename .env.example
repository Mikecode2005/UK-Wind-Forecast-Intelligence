# Elexon BMRS API
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1/datasets
ELEXON_ENABLE_CACHE=1
ELEXON_REQUEST_TIMEOUT=40
ELEXON_HTTP_VERIFY=false

# Backend
BACKEND_PORT=8000

# Frontend (Vite) — set on Vercel if frontend is separate from API
VITE_API_BASE_URL=http://localhost:8000

# Analysis defaults
ANALYSIS_FROM=2026-01-01
ANALYSIS_TO=2026-01-31
FORECAST_CUTOFF_HOUR=11
FORECAST_CUTOFF_MINUTE=0

# AI insights (optional)
# Put your key here — AI_API_KEY is preferred; OPENAI_API_KEY also works
AI_API_KEY=
# OPENAI_API_KEY=
# Optional overrides for OpenAI-compatible providers:
# AI_API_BASE=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
